# Disc Tools - ignore generated, downloaded, and local-only files

# Build / downloaded dependencies
third_party/
build/
dist/
release/
out/

# Runtime / generated files
Scripts/.config/
*.zip
*.tar
*.tar.gz
*.tar.bz2
*.tgz
*.log
*.tmp
*.temp

# Compiled objects / binaries
*.o
*.a
*.so
*.dll
*.exe
*.bin

# Editor / OS clutter
.vscode/
.idea/
.DS_Store
Thumbs.db
*~
*.swp
*.swo
